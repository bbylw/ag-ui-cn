---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import displayFace from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import textFace from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "../styles/landing.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import Nav from "../components/landing/Nav.astro";
import Hero from "../components/landing/Hero.astro";
import Works from "../components/landing/Works.astro";
import Sandbox from "../components/landing/Sandbox.astro";
import Features from "../components/landing/Features.astro";
import SdkQuickstart from "../components/landing/SdkQuickstart.astro";
import PlatformsCta from "../components/landing/PlatformsCta.astro";
import Footer from "../components/landing/Footer.astro";

const title = "AG-UI — 智能体与用户界面的开放交互协议";
const description =
  "AG-UI 是一个开放、轻量、事件驱动的协议，标准化 AI 智能体与前端应用之间的实时交互。支持流式聊天、共享状态、工具调用、生成式 UI 与人机协同。";
---

<BaseLayout
  title={title}
  description={description}
  fontPreloads={[textFace, displayFace]}
>
  <div class="kiri" id="main-content">
    <div class="k-grain" aria-hidden="true"></div>
    <Nav />
    <main>
      <Hero />
      <Works />
      <Sandbox />
      <Features />
      <SdkQuickstart />
      <PlatformsCta />
    </main>
    <Footer />
    <button class="k-top" type="button" data-k-top aria-label="回到顶部">
      <Icon name="ph:arrow-up" class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <script>
    import "../scripts/landing";
  </script>
</BaseLayout>
