---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

const title = "Kiri — 小巧快速的容器运行时";
const description =
  "Kiri 是一个用 Rust 从零构建的容器运行时，适用于 macOS、Windows 和 Linux。兼容 docker CLI、Compose 与 buildx，一条守护进程直连内核，启动容器只需数毫秒。";

const features = [
  {
    icon: "ph:cube",
    title: "容器与 Compose",
    desc: "你常用的每一条 docker 命令都能用，Compose 项目在窗口里按项目分组，每个容器都有独立页面：实时日志、终端与文件。",
  },
  {
    icon: "ph:package",
    title: "来自 Docker Hub 的镜像",
    desc: "在窗口里搜索 Docker Hub，逐层查看拉取进度；amd64 镜像通过 Rosetta 运行，无需手动处理架构差异。",
  },
  {
    icon: "ph:hammer",
    title: "构建与漏洞扫描",
    desc: "通过 BuildKit 执行 docker build，Builds 视图记录每次构建的步骤，镜像页面提供漏洞扫描结果。",
  },
  {
    icon: "ph:hexagon",
    title: "Kubernetes",
    desc: "kiri k8s start 在约 20 秒内给你一个 k3s 集群，Pod 与 Service 直接在窗口中查看，kind 也能运行。",
  },
  {
    icon: "ph:hard-drives",
    title: "Linux 机器",
    desc: "kiri machine create dev 创建长期存在的 Linux 环境：你的用户、sudo，以及相同路径下的 Mac 文件夹。",
  },
  {
    icon: "ph:cloud-arrow-up",
    title: "Kiri Share",
    desc: "为任意容器生成公网 HTTPS 链接，在窗口里点一下或执行 kiri share web 即可，随时断开。",
  },
  {
    icon: "ph:globe",
    title: "域名与 HTTPS",
    desc: "应用通过 web.kiri.local 打开，Compose 服务在 api.myapp.kiri.local，HTTPS 由 Kiri 自带的本地 CA 签发。",
  },
  {
    icon: "ph:feather",
    title: "对电脑足够轻",
    desc: "运行中即归还闲置内存，空闲一分钟后 VM 自动休眠；守护进程约 15 MB，唤醒仅需 0.15 秒。",
  },
  {
    icon: "ph:arrows-left-right",
    title: "一次性迁移",
    desc: "从 OrbStack 或 Docker Desktop 导入镜像、卷与容器，再在窗口里把 docker 切换到 Kiri。",
  },
];

const bench = [
  { name: "Kiri", ms: 22, note: "一条守护进程，直接调用内核", highlight: true },
  { name: "Colima", ms: 152, note: "VM 内的 Docker 引擎" },
  { name: "Docker Desktop", ms: 178, note: "dockerd · containerd · shim · runc" },
  { name: "OrbStack", ms: 279, note: "每容器常驻 shim 进程" },
];
const benchMax = 279;

const tools = [
  "docker",
  "docker compose",
  "docker buildx",
  "Docker Engine API",
  "Docker Hub",
  "OCI images",
  "ghcr.io",
  "Dockerfiles",
];

const languages = [
  "简体中文",
  "繁體中文",
  "日本語",
  "한국어",
  "Deutsch",
  "Français",
  "Español",
  "Italiano",
  "Português",
  "Polski",
  "Русский",
  "Türkçe",
  "Bahasa Indonesia",
  "Tiếng Việt",
  "English",
];

const steps = [
  {
    n: "01",
    title: "安装",
    desc: "打开安装包并把 Kiri 拖进「应用程序」。它会为 docker 做好准备。",
    code: null,
    href: "https://runkiri.com/download/",
    cta: "下载 Kiri",
  },
  {
    n: "02",
    title: "拉取镜像",
    desc: "在「镜像」中搜索 Docker Hub 并点击拉取，或者：",
    code: "docker pull nginx",
  },
  {
    n: "03",
    title: "运行容器",
    desc: "在窗口中点击「运行」并给它一个端口。毫秒级启动。",
    code: "docker run -p 80:80 nginx",
  },
  {
    n: "04",
    title: "分享",
    desc: "在容器上点击「分享」获得公网链接，或者：",
    code: "kiri share 80",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="landing min-h-screen flex flex-col bg-background">
    <!-- 公告条 -->
    <div class="border-b border-border bg-muted/60">
      <div class="mx-auto flex max-w-6xl items-center justify-center gap-2 px-4 py-2 text-[0.8125rem] text-muted-foreground">
        <span class="rounded-full border border-border bg-card px-2 py-0.5 text-[0.6875rem] font-medium text-foreground">Beta</span>
        <a
          href="https://runkiri.com/releases/"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 no-underline text-muted-foreground hover:text-foreground transition-colors"
        >
          <span class="font-medium text-foreground">Kiri 0.2.0 已发布</span>
          <span class="hidden sm:inline">· macOS · Windows · Linux</span>
          <Icon aria-hidden="true" name="ph:arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>

    <Header />

    <main id="main-content" tabindex="-1" class="flex-1">
      <!-- Hero -->
      <section class="relative overflow-hidden border-b border-border">
        <div
          class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_0%,color-mix(in_oklch,var(--nb-brand)_10%,transparent)_0%,transparent_70%)]"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-0 -z-10 opacity-40 [background-image:radial-gradient(circle_at_1px_1px,var(--nb-border-strong)_1px,transparent_0)] [background-size:22px_22px] [mask-image:radial-gradient(ellipse_55%_45%_at_50%_0%,black,transparent)]"
        >
        </div>
        <div class="mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-14 sm:px-6 sm:pb-24 sm:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-10 lg:px-8">
          <div class="max-w-2xl">
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs text-muted-foreground shadow-[var(--nb-shadow-sm)]">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
              用 Rust 从零构建，不基于 Docker 的组件
            </div>
            <h1 class="text-[2.6rem] font-semibold leading-[1.08] tracking-[-0.02em] text-foreground sm:text-[3.4rem]">
              容器启动，<br />
              在你<span class="relative isolate inline-block text-brand"><span class="absolute inset-x-0 bottom-[0.08em] -z-10 h-[0.55em] rounded-sm bg-brand/15"></span>眨眼之前</span>。
            </h1>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-lg font-medium text-foreground sm:text-xl">
              <span>比 Docker Desktop 快</span>
              <span class="text-[1.6em] font-semibold leading-none text-brand">8 倍</span>
            </p>
            <p class="mt-3 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
              Kiri 用一条守护进程运行 Docker 容器：镜像、Compose、buildx 与 Docker Engine API
              都照常工作，只是背后的调用链更短、占用更小。
            </p>
            <div class="mt-5 space-y-1.5 text-sm">
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <code class="rounded bg-accent px-1.5 py-0.5 font-mono text-[0.8125rem] text-foreground">docker run</code>
                <span class="font-medium text-foreground">22 ms</span>
                <span class="text-muted-foreground">对比</span>
                <span class="text-muted-foreground">Docker Desktop 178 ms</span>
              </div>
              <div class="flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground">
                <span>2 CPU / 8 GB 环境，同一 docker CLI，取中位数</span>
                <a href="/guide/benchmarks/" class="inline-flex items-center gap-0.5 font-medium text-brand no-underline hover:underline">
                  查看基准测试
                  <Icon aria-hidden="true" name="ph:arrow-right" class="h-3 w-3" />
                </a>
              </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="https://runkiri.com/download/"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground no-underline shadow-[var(--nb-shadow)] transition-colors hover:bg-primary-hover"
              >
                <Icon aria-hidden="true" name="ph:download-simple" class="h-4 w-4" />
                下载 Kiri
              </a>
              <a
                href="/quick-start/"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium text-foreground no-underline shadow-[var(--nb-shadow-sm)] transition-colors hover:bg-accent"
              >
                阅读文档
                <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
              </a>
            </div>
            <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center gap-1.5">
                <Icon aria-hidden="true" name="ph:check-circle" class="h-3.5 w-3.5 text-success" />
                免费开源（Apache-2.0 / MIT）
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Icon aria-hidden="true" name="ph:check-circle" class="h-3.5 w-3.5 text-success" />
                兼容 Docker Engine API
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Icon aria-hidden="true" name="ph:check-circle" class="h-3.5 w-3.5 text-success" />
                macOS · Windows · Linux
              </span>
            </p>
          </div>

          <!-- 应用窗口示意 -->
          <div class="relative">
            <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(50%_50%_at_60%_30%,color-mix(in_oklch,var(--nb-brand)_14%,transparent),transparent_70%)] blur-2xl"></div>
            <div aria-hidden="true" class="overflow-hidden rounded-xl border border-border bg-card shadow-[var(--nb-shadow-lg)] ring-1 ring-foreground/5">
              <div class="flex items-center gap-2 border-b border-border bg-muted/60 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-danger/60"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-warning/60"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-success/60"></span>
                <span class="ms-2 text-xs font-medium text-muted-foreground">Kiri</span>
                <span class="ms-auto inline-flex items-center gap-1.5 text-[0.6875rem] text-muted-foreground">
                  <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                  Linux VM 运行中
                </span>
              </div>
              <div class="grid grid-cols-1 text-[0.8125rem] sm:grid-cols-[7.5rem_1fr]">
                <div class="hidden border-e border-border bg-muted/40 p-3 text-xs sm:block">
                  <div class="space-y-1">
                    <div class="rounded-md bg-accent px-2 py-1.5 font-medium text-foreground">容器 <span class="float-end text-success">4</span></div>
                    <div class="rounded-md px-2 py-1.5 text-muted-foreground">镜像 <span class="float-end">7</span></div>
                    <div class="rounded-md px-2 py-1.5 text-muted-foreground">卷 <span class="float-end">3</span></div>
                    <div class="rounded-md px-2 py-1.5 text-muted-foreground">网络 <span class="float-end">3</span></div>
                    <div class="rounded-md px-2 py-1.5 text-muted-foreground">构建</div>
                    <div class="rounded-md px-2 py-1.5 text-muted-foreground">Kubernetes <span class="float-end text-success">开</span></div>
                  </div>
                  <div class="mt-4 border-t border-border pt-3">
                    <div class="text-[0.6875rem] text-muted-foreground">CPU</div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-border">
                      <div class="h-full w-[23%] rounded-full bg-success"></div>
                    </div>
                    <div class="mt-2 text-[0.6875rem] text-muted-foreground">内存</div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-border">
                      <div class="h-full w-[41%] rounded-full bg-info"></div>
                    </div>
                  </div>
                </div>
                <div class="p-3">
                  <div class="mb-2 flex items-center justify-between text-[0.6875rem] text-muted-foreground">
                    <span>4 个运行中 · 共 5 个</span>
                    <span class="rounded border border-border px-1.5 py-0.5">筛选</span>
                  </div>
                  <div class="space-y-1.5">
                    {[
                      { name: "web", img: "nginx:alpine", state: "已分享", live: true },
                      { name: "api", img: "node:22", state: "运行 2 分钟" },
                      { name: "db", img: "postgres:17", state: "运行 2 分钟" },
                      { name: "redis", img: "redis:7", state: "已退出" },
                    ].map((c) => (
                      <div class="flex items-center gap-2 rounded-md border border-transparent px-2 py-1.5 hover:border-border hover:bg-accent/50">
                        <span class:list={["h-1.5 w-1.5 shrink-0 rounded-full", c.live ? "bg-success" : c.state === "已退出" ? "bg-border-strong" : "bg-info"]}></span>
                        <span class="w-12 shrink-0 font-medium text-foreground">{c.name}</span>
                        <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-muted-foreground">{c.img}</span>
                        <span class:list={["shrink-0 text-[0.6875rem]", c.live ? "text-brand font-medium" : "text-muted-foreground"]}>{c.state}</span>
                      </div>
                    ))}
                  </div>
                  <div class="mt-3 flex items-center gap-2 rounded-md border border-border bg-muted/50 px-2 py-1.5 text-[0.6875rem]">
                    <Icon aria-hidden="true" name="ph:globe" class="h-3.5 w-3.5 text-success" />
                    <span class="min-w-0 flex-1 truncate font-mono text-foreground">https://web.runkiri.cloud</span>
                    <span class="shrink-0 text-muted-foreground">复制</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 border-t border-border bg-muted/40 px-3 py-1.5 text-[0.6875rem] text-muted-foreground">
                <span class="font-medium text-foreground">Kiri 0.2.0</span>
                <span>Linux VM 运行中</span>
                <span class="ms-auto hidden sm:inline">4 / 5 运行 · 657 MB / 4 GB</span>
                <span class="hidden sm:inline">docker → Kiri</span>
              </div>
            </div>
            <p class="mt-3 text-center text-[0.6875rem] text-muted-foreground">界面示意：容器、Compose 分组、实时日志与分享链接都在同一个窗口里。</p>
          </div>
        </div>

        <!-- 语言 -->
        <div class="border-t border-border bg-muted/30">
          <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-7 text-center sm:px-6 lg:px-8">
            <p class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-muted-foreground">
              Kiri 的窗口现已支持 15 种语言
            </p>
            <ul role="list" class="m-0 flex w-full list-none gap-1.5 overflow-x-auto p-0 pb-1 [scrollbar-width:none] sm:flex-wrap sm:justify-center sm:overflow-visible sm:pb-0 [&::-webkit-scrollbar]:hidden">
              {languages.map((l) => (
                <li
                  class:list={[
                    "shrink-0 whitespace-nowrap rounded-full border px-2.5 py-1 text-[0.6875rem]",
                    l === "简体中文"
                      ? "border-brand/30 bg-brand-wash font-medium text-brand"
                      : "border-border bg-card text-muted-foreground",
                  ]}
                >
                  {l}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 基准测试 -->
      <section class="border-b border-border">
        <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">实测</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              同一条 docker run，<br class="hidden sm:block" />更短的一条路径。
            </h2>
            <p class="mt-4 max-w-md text-base leading-7 text-muted-foreground">
              OrbStack 与 Docker Desktop 的每次容器启动都要经过五个程序，每个程序各有自己的 socket。Kiri 只经过一条守护进程，由它直接调用内核。
            </p>
            <div class="mt-6 inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-2 font-mono text-xs text-foreground shadow-[var(--nb-shadow-sm)]">
              <span class="text-muted-foreground">$</span> docker run --rm alpine true
            </div>
            <p class="mt-4 text-xs leading-5 text-muted-foreground">
              一台 Apple Silicon Mac 上的一次完整测量，所有引擎限制为 2 CPU / 8 GB，使用同一个 docker CLI 与默认 bridge 网络，取中位数。
              <a href="/guide/benchmarks/" class="ms-1 font-medium text-brand no-underline hover:underline">查看完整数据</a>
            </p>
          </div>

          <div class="rounded-xl border border-border bg-card p-5 shadow-[var(--nb-shadow-sm)] sm:p-6">
            <div class="mb-5 flex items-baseline justify-between">
              <span class="text-xs font-medium text-muted-foreground">docker run 启动并退出（毫秒，越低越好）</span>
              <span class="text-xs text-muted-foreground">p50</span>
            </div>
            <div class="space-y-5">
              {bench.map((b) => (
                <div>
                  <div class="mb-1.5 flex items-baseline justify-between gap-3">
                    <span class:list={["text-sm", b.highlight ? "font-semibold text-foreground" : "text-muted-foreground"]}>{b.name}</span>
                    <span class:list={["font-mono text-sm tabular-nums", b.highlight ? "font-semibold text-brand" : "text-muted-foreground"]}>
                      {b.ms} ms
                    </span>
                  </div>
                  <div class="h-2.5 overflow-hidden rounded-full bg-accent">
                    <div
                      class:list={["bench-bar h-full rounded-full", b.highlight ? "bg-brand" : "bg-border-strong"]}
                      style={`width: ${Math.max(13, Math.round((b.ms / benchMax) * 100))}%`}
                    >
                    </div>
                  </div>
                  <p class="mt-1.5 text-[0.6875rem] text-muted-foreground">{b.note}</p>
                </div>
              ))}
            </div>
            <div class="mt-6 flex items-center gap-2 border-t border-border pt-4 text-xs text-muted-foreground">
              <Icon aria-hidden="true" name="ph:info" class="h-3.5 w-3.5" />
              Kiri 的 22 ms 中大部分是 docker CLI 自身的启动时间；通过 Docker API 完成整个容器生命周期约 3 ms。
            </div>
          </div>
        </div>
      </section>

      <!-- 兼容工具 -->
      <section class="border-b border-border bg-muted/30">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
          <div class="flex flex-col items-center gap-6 text-center">
            <p class="text-sm font-medium text-muted-foreground">与你已经在用的工具完全兼容</p>
            <ul role="list" class="m-0 flex list-none flex-wrap justify-center gap-2 p-0">
              {tools.map((t) => (
                <li class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-2 font-mono text-xs text-foreground shadow-[var(--nb-shadow-sm)] transition-colors hover:border-border-strong hover:bg-accent/40">
                  <Icon aria-hidden="true" name="ph:check" class="h-3.5 w-3.5 text-success" />
                  {t}
                </li>
              ))}
            </ul>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
              你的 Dockerfile、compose.yaml 与脚本无需修改；Kiri 添加一个 <code class="rounded bg-accent px-1.5 py-0.5 text-foreground">kiri</code> 上下文，切换与否由你决定。
            </p>
          </div>
        </div>
      </section>

      <!-- 功能 -->
      <section class="border-b border-border">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">全部能力</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              你会为 Docker Desktop 打开的每一件事。
            </h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground sm:text-lg">
              容器只是起点。Kiri 还能构建与扫描镜像、运行 Kubernetes 与完整的 Linux 机器，并把任意容器一键放上公网。
            </p>
          </div>

          <ul role="list" class="m-0 mt-12 grid list-none gap-px overflow-hidden rounded-xl border border-border bg-border p-0 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((f) => (
              <li class="group bg-card p-6 transition-colors hover:bg-accent/40 sm:p-7">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-brand/15 bg-brand-wash text-brand transition-transform duration-200 group-hover:-translate-y-0.5">
                  <Icon aria-hidden="true" name={f.icon} class="h-4.5 w-4.5" />
                </span>
                <h3 class="mt-4 text-base font-semibold text-foreground">{f.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.desc}</p>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/docker/containers/" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-foreground no-underline transition-colors hover:bg-accent">
              容器与 Compose 文档
