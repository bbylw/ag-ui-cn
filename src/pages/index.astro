---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "../styles/landing.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import Nav from "../components/landing/Nav.astro";
import Hero from "../components/landing/Hero.astro";
import Works from "../components/landing/Works.astro";
import Race from "../components/landing/Race.astro";
import Features from "../components/landing/Features.astro";
import Cli from "../components/landing/Cli.astro";
import Share from "../components/landing/Share.astro";
import Resource from "../components/landing/Resource.astro";
import Start from "../components/landing/Start.astro";
import How from "../components/landing/How.astro";
import AppCta from "../components/landing/AppCta.astro";
import Footer from "../components/landing/Footer.astro";

const title = "Kiri — 容器启动，快过眨眼";
const description =
  "Kiri 是一个用 Rust 从零构建的容器运行时，适用于 macOS、Windows 和 Linux。兼容 docker CLI、Compose 与 buildx，一条守护进程直连内核，Engine API 响应 2.55 ms，启动容器只需数毫秒。";
---

<BaseLayout title={title} description={description}>
  <div class="kiri" id="main-content">
    <div class="k-grain" aria-hidden="true"></div>
    <Nav />
    <main>
      <Hero />
      <Works />
      <Race />
      <Features />
      <Cli />
      <Share />
      <Resource />
      <Start />
      <How />
      <AppCta />
    </main>
    <Footer />
    <button class="k-top" type="button" data-k-top aria-label="回到顶部">
      <Icon name="ph:arrow-up" class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <script>
    import "../scripts/landing";
  </script>
</BaseLayout>