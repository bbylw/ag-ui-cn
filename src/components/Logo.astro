---
import { logo } from "./logo";

interface Props { class?: string }
const { class: cls = "h-6" } = Astro.props;
---

<span class:list={["inline-flex items-center text-foreground", cls]} aria-hidden="true">
  <svg
    class="h-full w-auto dark:hidden"
    width={logo.width}
    height={logo.height}
    viewBox={`0 0 ${logo.width} ${logo.height}`}
    xmlns="http://www.w3.org/2000/svg"
    set:html={logo.light}
  />
  <svg
    class="hidden h-full w-auto dark:block"
    width={logo.width}
    height={logo.height}
    viewBox={`0 0 ${logo.width} ${logo.height}`}
    xmlns="http://www.w3.org/2000/svg"
    set:html={logo.dark}
  />
</span>
