---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import Mark from "./Mark.astro";
import { GITHUB_URL, OFFICIAL_DOCS_URL, DOJO_URL, DISCORD_URL } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "文档",
    links: [
      { label: "AG-UI 简介", href: href("/intro/") },
      { label: "快速开始", href: href("/quickstart/") },
      { label: "核心架构", href: href("/concepts/architecture/") },
      { label: "事件机制", href: href("/concepts/events/") },
      { label: "核心能力", href: href("/concepts/building-blocks/") },
    ],
  },
  {
    title: "生态",
    links: [
      { label: "生态与集成", href: href("/integrations/") },
      { label: "SDK 与客户端", href: href("/sdk/") },
      { label: "资源与链接", href: href("/resources/") },
    ],
  },
  {
    title: "官方",
    links: [
      { label: "官方文档", href: OFFICIAL_DOCS_URL, external: true },
      { label: "GitHub", href: GITHUB_URL, external: true },
      { label: "AG-UI Dojo", href: DOJO_URL, external: true },
      { label: "Discord 社区", href: DISCORD_URL, external: true },
    ],
  },
];
---

<footer class="k-footer k-defer">
  <div class="k-wrap">
    <div class="k-foot-grid">
      <div>
        <a href={href("/")} class="k-foot-brand">
          <Mark class="k-logo k-foot-logo" />
        </a>
        <p class="k-foot-tag">
          AG-UI 是一个开放、轻量、事件驱动的协议，用于连接 AI 智能体与面向用户的应用，支持实时交互、共享状态、工具调用与生成式 UI。
        </p>
      </div>
      {
        columns.map((c) => (
          <div>
            <p class="k-foot-h">{c.title}</p>
            <ul class="k-foot-list" role="list">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} {...l.external ? { target: "_blank", rel: "noopener" } : {}}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <a href="#top" class="k-foot-top">
      <Icon name="ph:arrow-up" class="h-3.5 w-3.5" aria-hidden="true" />
      回到顶部
    </a>
    <p class="k-legal">
      本站为 AG-UI 中文介绍与文档站点，内容基于{" "}
      <a href={GITHUB_URL} target="_blank" rel="noopener">AG-UI GitHub README</a>
      {" "}与{" "}
      <a href="https://docs.ag-ui.com/introduction" target="_blank" rel="noopener">官方 Introduction 文档</a>
      {" "}整理翻译与重组。AG-UI 协议采用 MIT 许可证。本站使用 Nimbus 与 Astro 构建。
    </p>
  </div>
</footer>
