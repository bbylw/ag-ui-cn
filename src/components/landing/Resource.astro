---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<section class="k-section k-defer" id="resource" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="OBS-04">可观测与可控</p>
      <h2 class="k-h2">把智能体过程变成可理解的交互。</h2>
      <p class="k-lede">
        面向用户的智能体不仅要“给出答案”，还要展示进展、解释状态、处理工具结果并在必要时请求确认。
        AG-UI 的事件模型为这些体验提供了统一基础。
      </p>
    </header>

    <div class="k-rl" data-k-rl data-reveal>
      <div class="k-rl-controls">
        <h3><Icon name="ph:sliders-horizontal" class="h-[18px] w-[18px]" aria-hidden="true" />交互要素</h3>

        <div class="k-ctl">
          <span class="k-ctl-k">并发事件流 <b data-k-rl-containers-val>4</b></span>
          <input type="range" id="k-rl-containers" name="rl-containers" class="k-range" data-k-rl-containers min="0" max="12" step="1" value="4" aria-label="并发事件流数量" />
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">每流负载 <b data-k-rl-per-val>128</b></span>
          <input type="range" id="k-rl-per" name="rl-per" class="k-range" data-k-rl-per min="32" max="512" step="16" value="128" aria-label="每个事件流负载" />
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">时间流速 <b data-k-rl-speed-val>6×</b></span>
          <input type="range" id="k-rl-speed" name="rl-speed" class="k-range" data-k-rl-speed min="1" max="20" step="1" value="6" aria-label="模拟时间流速" />
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">空闲窗口</span>
          <select id="k-rl-idle" name="rl-idle" class="k-select" data-k-rl-idle aria-label="空闲窗口">
            <option value="30">30 秒</option>
            <option value="60" selected>60 秒</option>
            <option value="120">120 秒</option>
          </select>
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">操作</span>
          <div class="k-rl-actions">
            <button type="button" class="k-run" data-k-rl-play>
              <Icon name="ph:play" class="k-i-play h-4 w-4" aria-hidden="true" />
              <Icon name="ph:pause" class="k-i-pause h-4 w-4" aria-hidden="true" />
              <span data-k-rl-play-label>暂停</span>
            </button>
            <button type="button" class="k-run k-run-ghost" data-k-rl-wake>刷新状态</button>
            <button type="button" class="k-run k-run-ghost" data-k-rl-reset>重置</button>
          </div>
        </div>

        <label class="k-switch">
          <input type="checkbox" id="k-rl-auto" name="rl-auto" data-k-rl-auto />
          <i />
          自动演示：事件波动
        </label>
      </div>

      <div class="k-rl-stage">
        <div class="k-rl-head">
          <span class="k-rl-state" data-k-rl-state><i></i><span data-k-rl-state-text>会话进行中</span></span>
          <span class="k-rl-clock">模拟时间 <b data-k-rl-clock>00:00</b></span>
        </div>

        <div class="k-rl-meters">
          <div class="k-meter-row">
            <span>事件吞吐</span>
            <span class="k-meter"><span class="k-meter-fill" data-k-rl-vm-fill></span></span>
            <span class="k-meter-val" data-k-rl-vm-val>512</span>
          </div>
          <div class="k-meter-row">
            <span>基础开销</span>
            <span class="k-meter"><span class="k-meter-fill is-daemon" data-k-rl-daemon-fill></span></span>
            <span class="k-meter-val" data-k-rl-daemon-val>15</span>
          </div>
          <div class="k-meter-row">
            <span>空闲窗口</span>
            <span class="k-meter"><span class="k-meter-fill" data-k-rl-idle-fill style="background:linear-gradient(90deg,#b4690e,#ffc23d)"></span></span>
            <span class="k-meter-val" data-k-rl-idle-val>0 / 60 s</span>
          </div>
        </div>

        <div class="k-rl-graph">
          <div class="k-rl-graph-k"><span>交互活动 · 最近 2 分钟</span><span data-k-rl-peak>峰值 512</span></div>
          <svg viewBox="0 0 300 96" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="k-rl-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#6ea8ff" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#6ea8ff" stop-opacity="0" />
              </linearGradient>
            </defs>
            <line x1="0" y1="24" x2="300" y2="24" stroke="rgba(255,255,255,.07)" stroke-width="1" />
            <line x1="0" y1="60" x2="300" y2="60" stroke="rgba(255,255,255,.07)" stroke-width="1" />
            <path data-k-rl-area fill="url(#k-rl-grad)" d="" />
            <polyline data-k-rl-line fill="none" stroke="#6ea8ff" stroke-width="2" stroke-linejoin="round" points="" />
          </svg>
        </div>

        <ul class="k-rl-log" role="list" data-k-rl-log>
          <li><b>00:00</b><span>会话已建立，等待用户输入与智能体事件</span></li>
        </ul>

        <p class="k-rl-note">
          本面板为交互可观测性的示意演示，用于说明事件流、状态与中断如何共同构成可控体验。协议细节请参阅
          <a href={href("/concepts/events/")}>事件机制</a> 与 <a href={href("/concepts/building-blocks/")}>核心能力</a>。
        </p>
      </div>
    </div>
  </div>
</section>
