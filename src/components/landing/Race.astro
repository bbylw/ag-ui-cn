---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { raceEngines, raceCommand } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const toneVar = { kiri: "var(--k-ember)", dd: "var(--k-teal)", orb: "var(--k-orchid)" } as const;
---

<section class="k-section k-defer" id="race" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="FLOW-01">对比</p>
      <h2 class="k-h2">从临时对接到标准化交互。</h2>
      <p class="k-lede">
        没有统一协议时，流式输出、状态同步、工具调用与中断往往需要在每个项目里重复拼装。
        AG-UI 用一致的事件模型把智能体与界面连接起来，让交互链路更清晰、更易扩展。
      </p>
    </header>

    <div class="k-race" data-k-race data-reveal>
      <div class="k-rc-bar">
        <i></i><i></i><i></i>
        <code class="k-rc-title" data-k-race-cmd>{raceCommand.events}</code>
        <span class="k-rc-live" data-k-race-live><i></i><span data-k-race-state>待演示</span></span>
      </div>

      <div class="k-rc-tools">
        <div class="k-ctl">
          <span class="k-ctl-k">交互场景</span>
          <div class="k-seg" role="group" aria-label="交互场景">
            <button type="button" class="k-seg-b is-on" data-k-path="events" aria-pressed="true">事件流</button>
            <button type="button" class="k-seg-b" data-k-path="state" aria-pressed="false">状态同步</button>
          </div>
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">慢放 <b data-k-speed-val>40×</b></span>
          <div class="k-ctl-row">
            <input type="range" class="k-range" data-k-speed min="1" max="120" step="1" value="40" aria-label="慢放倍数" />
          </div>
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">播放</span>
          <div class="k-ctl-row">
            <button type="button" class="k-run" data-k-play>
              <Icon name="ph:play" class="k-i-play h-4 w-4" aria-hidden="true" />
              <Icon name="ph:pause" class="k-i-pause h-4 w-4" aria-hidden="true" />
              <span data-k-play-label>开始</span>
            </button>
            <button type="button" class="k-run k-run-ghost" data-k-replay>
              <Icon name="ph:arrow-clockwise" class="h-4 w-4" aria-hidden="true" />
              重播
            </button>
          </div>
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">方案</span>
          <div class="k-ctl-row">
            {
              raceEngines.map((e) => (
                <label class="k-switch">
                  <input type="checkbox" data-k-engine={e.id} checked />
                  <i />
                  {e.name}
                </label>
              ))
            }
          </div>
        </div>

        <div class="k-ctl">
          <span class="k-ctl-k">显示</span>
          <div class="k-ctl-row">
            <label class="k-switch"><input type="checkbox" data-k-loop checked /><i />循环</label>
            <label class="k-switch"><input type="checkbox" data-k-residue checked /><i />额外适配</label>
            <button type="button" class="k-run k-run-ghost" data-k-reset>重置</button>
          </div>
        </div>
      </div>

      <div class="k-rc-lanes">
        {
          raceEngines.map((e) => (
            <div class:list={["k-lane", e.tone === "kiri" && "is-kiri"]} data-k-lane={e.id} style={`--k-lane-color: ${toneVar[e.tone]}`}>
              <div class="k-lane-head">
                <span class="k-lane-name">{e.name}</span>
                <span class="k-chip k-chip-moss">示意</span>
                <b class="k-timer" data-k-timer>0 ms</b>
              </div>
              <div class="k-track" data-k-track>
                <div class="k-track-fill" data-k-fill />
                {e.stops.events.map((s, i) => (
                  <span class="k-stop" style={`left:${(i / (e.stops.events.length - 1)) * 100}%`}>
                    <span>{s}</span>
                  </span>
                ))}
                <span class="k-token" data-k-token aria-hidden="true" />
              </div>
              <p class="k-lane-note">{e.note}</p>
              <p class:list={["k-residue", e.residue === 0 && "is-zero"]} data-k-residue-row>
                <Icon name="ph:stack" class="h-3.5 w-3.5" aria-hidden="true" />
                额外适配层 <b>{e.residue === 0 ? "0" : "多"}</b> 个
              </p>
            </div>
          ))
        }
      </div>

      <p class="k-rc-foot">
        本节为协议价值的可视化示意，用于说明标准事件模型如何减少自定义胶水代码与重复适配。实际收益取决于框架、传输方式与应用架构。
        <a href={href("/concepts/architecture/")}>了解核心架构 →</a>
      </p>
    </div>

    <div class="k-bars" data-k-bars data-reveal>
      {
        raceEngines.map((e) => (
          <div class:list={["k-bar-row", e.tone === "kiri" && "is-kiri"]} data-k-bar={e.id}>
            <span class="k-bar-name">{e.name}</span>
            <span class="k-bar-track">
              <span class="k-bar-fill" style={`--k-bar-color: ${toneVar[e.tone]}`} data-k-bar-fill />
            </span>
            <span class="k-bar-val" data-k-bar-val>{e.ms.events} ms</span>
          </div>
        ))
      }
    </div>
    <p class="k-legend">
      <span><i class="k-sw" style="background:var(--k-orchid)"></i>临时拼接</span>
      <span><i class="k-sw" style="background:var(--k-teal)"></i>局部协议</span>
      <span><i class="k-sw" style="background:var(--k-ember)"></i>AG-UI</span>
      <span data-k-bars-caption>交互链路复杂度示意 · 越低越好</span>
    </p>
  </div>
</section>
