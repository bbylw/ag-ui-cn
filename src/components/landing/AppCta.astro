---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { platforms, QUICKSTART_URL, OFFICIAL_DOCS_URL } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<section class="k-section k-alt k-defer" id="app" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="APP-07">客户端与场景</p>
      <h2 class="k-h2">同一协议，适配多种交互入口。</h2>
      <p class="k-lede">
        AG-UI 描述的是事件流与交互语义，因此客户端不局限于网页。你可以在浏览器、终端或协作平台中，为用户提供一致的智能体体验。
      </p>
    </header>

    <div class="k-ap-grid">
      {
        platforms.map((p, i) => (
          <a href={href(p.href)} class="k-ap" data-reveal data-i={i}>
            <span class="k-ap-badge">
              <Icon name={p.icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3>
              {p.name}
              <Icon name="ph:arrow-up-right" class="h-[18px] w-[18px]" aria-hidden="true" />
            </h3>
            <p>{p.desc}</p>
            <small>{p.badge}</small>
          </a>
        ))
      }
    </div>

    <div class="k-band" style="margin-top:34px" data-reveal>
      <div>
        <h2>开始构建你的 AG-UI 应用</h2>
        <p>
          使用脚手架创建项目，连接兼容 AG-UI 的智能体后端，在前端订阅标准事件流，即可获得实时聊天、状态同步与工具交互能力。
        </p>
        <div class="k-cmd k-band-cmd">
          <code>npx create-ag-ui-app@latest my-agent-app</code>
          <button type="button" class="k-copy" data-copy="npx create-ag-ui-app@latest my-agent-app" aria-label="复制命令">
            <Icon name="ph:copy" class="h-3.5 w-3.5" aria-hidden="true" />
          </button>
        </div>
      </div>
      <div class="k-band-actions">
        <a href={href(QUICKSTART_URL)} class="k-btn">
          <Icon name="ph:rocket-launch" class="h-[18px] w-[18px]" aria-hidden="true" />
          快速开始
        </a>
        <a href={OFFICIAL_DOCS_URL} target="_blank" rel="noopener" class="k-btn k-btn-ghost">官方文档</a>
      </div>
    </div>
  </div>
</section>

<section class="k-section k-defer" id="docs" tabindex="-1">
  <div class="k-wrap">
    <div class="k-band" data-reveal>
      <div>
        <h2>从概念到落地，一站式阅读。</h2>
        <p>
          本站基于 AG-UI 官方 README 与文档简介整理，提供协议概述、核心架构、事件机制、能力构建块、生态集成与 SDK 客户端等中文内容，帮助你快速理解并接入 AG-UI。
        </p>
      </div>
      <div class="k-band-actions">
        <a href={href("/intro/")} class="k-btn">
          进入文档
          <Icon name="ph:arrow-right" class="h-[18px] w-[18px]" aria-hidden="true" />
        </a>
        <a href={href("/resources/")} class="k-btn k-btn-ghost">资源链接</a>
      </div>
    </div>
  </div>
</section>
