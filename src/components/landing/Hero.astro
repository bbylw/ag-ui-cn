---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { QUICKSTART_URL, DOJO_URL, stackLayers, heroScenarios } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const initial = heroScenarios[0];
---

<section class="k-hero" id="top" tabindex="-1">
  <div class="k-wrap k-hero-grid">
    <div class="k-hero-copy">
      <p class="k-eyebrow"><span class="k-dot"></span>开放协议 · 事件驱动 · 实时双向</p>

      <h1 class="k-h1">让智能体<br /><em class="k-underline">真正融入用户界面</em>。</h1>

      <p class="k-hero-lede">
        AG-UI（Agent–User Interaction Protocol）标准化 AI 智能体与前端应用之间的实时事件流与状态交互，一套协议即可驱动流式对话、工具执行、生成式 UI 与人机协同。
      </p>

      <div class="k-stack-card">
        <div class="k-stack-top">
          <span class="k-stat-k">协议栈定位 · Agentic Protocol Stack</span>
          <span class="k-chip k-chip-ember">31 标准事件 · 8 大事件族</span>
        </div>
        <ul class="k-stack-list" role="list">
          {
            stackLayers.map((layer) => (
              <li class:list={["k-stack-item", layer.active && "is-active"]}>
                <div class="k-stack-head">
                  <b>{layer.name}</b>
                  <span>{layer.scope}</span>
                </div>
                <p>{layer.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="k-cta">
        <a href={href(QUICKSTART_URL)} class="k-btn">
          <Icon name="ph:lightning" class="h-[18px] w-[18px]" aria-hidden="true" />
          快速开始
        </a>
        <a href={href("/intro/")} class="k-btn k-btn-ghost">
          阅读文档
          <Icon name="ph:arrow-right" class="h-[18px] w-[18px]" aria-hidden="true" />
        </a>
        <a href={DOJO_URL} target="_blank" rel="noopener" class="k-btn k-btn-ghost">
          打开 Dojo
          <Icon name="ph:arrow-up-right" class="h-[16px] w-[16px]" aria-hidden="true" />
        </a>
      </div>

      <p class="k-proof">
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />开放协议 · MIT 许可</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />HTTP SSE / WebSocket 传输无关</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />前后端解耦互操作</span>
      </p>
    </div>

    <div class="k-hero-side">
      <figure class="k-hx" data-k-hero-inspector>
        <div class="k-hx-glow" aria-hidden="true"></div>
        <div class="k-win">
          <div class="k-win-bar">
            <i></i><i></i><i></i>
            <b>AG-UI Protocol Inspector</b>
            <em>text/event-stream</em>
          </div>

          <div class="k-h-toolbar">
            <div class="k-seg k-seg-sm" role="tablist" aria-label="首屏协议联动场景">
              {
                heroScenarios.map((sc, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`k-h-tab-${sc.id}`}
                    class:list={["k-seg-b", i === 0 && "is-on"]}
                    aria-selected={i === 0 ? "true" : "false"}
                    aria-controls="k-h-panel"
                    tabindex={i === 0 ? 0 : -1}
                    data-k-h-tab={sc.id}
                  >
                    {sc.label}
                  </button>
                ))
              }
            </div>
            <span class="k-vm"><i></i>实时联动</span>
          </div>

          <div
            class="k-h-panel"
            id="k-h-panel"
            role="tabpanel"
            aria-labelledby={`k-h-tab-${initial.id}`}
            data-k-h-panel
          >
            <div class="k-wire-pane">
              <div class="k-pane-k">
                <span>协议事件流 · Wire</span>
                <code>POST /agent</code>
              </div>
              <ul class="k-list" role="list" data-k-h-wire>
                {
                  initial.events.map((ev) => (
                    <li class="k-row">
                      <span
                        class:list={[
                          "k-row-dot",
                          ev.tone === "idle" && "is-idle",
                          ev.tone === "rose" && "is-share",
                          ev.tone === "accent" && "is-accent",
                        ]}
                      />
                      <span class="k-row-name">{ev.type}</span>
                      <span class="k-row-img">{ev.meta}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="k-ui-pane">
              <div class="k-pane-k">
                <span>客户端渲染 · App UI</span>
                <span class="k-pane-pill" data-k-h-badge>{initial.widget.badge}</span>
              </div>

              <div class="k-chat-mini">
                <p class="k-chat-u" data-k-h-prompt>{initial.prompt}</p>
                <p class="k-chat-a" data-k-h-reply>{initial.reply}</p>
              </div>

              <div class="k-widget-mini" data-k-h-widget>
                <div class="k-widget-head">
                  <strong data-k-h-wtitle>{initial.widget.title}</strong>
                  <span class="k-widget-dot" aria-hidden="true"></span>
                </div>
                <div class="k-widget-rows" data-k-h-wrows>
                  {
                    initial.widget.rows.map((r) => (
                      <div class:list={["k-wrow", r.highlight && "is-hi"]}>
                        <span>{r.k}</span>
                        <b>{r.v}</b>
                      </div>
                    ))
                  }
                </div>
                <div class="k-widget-act" data-k-h-act hidden>
                  <button type="button" class="k-btn k-btn-xs" data-k-h-approve>批准执行</button>
                </div>
              </div>
            </div>
          </div>

          <div class="k-win-foot">
            <span>Agent Backend → Event Stream → App UI</span>
            <span>点击上方场景体验事件与界面联动</span>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>
