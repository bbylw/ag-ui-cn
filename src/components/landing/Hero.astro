---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { DOWNLOAD_URL, languages } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;

const rail = [
  { icon: "ph:cube", on: true },
  { icon: "ph:package" },
  { icon: "ph:hammer" },
  { icon: "ph:hexagon" },
  { icon: "ph:hard-drives" },
];

const rows = [
  { name: "web", img: "nginx:alpine", state: "已分享", tone: "share", up: 128 },
  { name: "api", img: "node:22", state: "运行 2 分钟", tone: "live", up: 122 },
  { name: "db", img: "postgres:17", state: "运行 2 分钟", tone: "live", up: 121 },
  { name: "redis", img: "redis:7", state: "已退出", tone: "idle", up: 0 },
];
---

<section class="k-hero" id="top">
  <div class="k-wrap k-hero-grid">
    <div class="k-hero-copy">
      <p class="k-eyebrow"><span class="k-dot"></span>用 Rust 从零构建 · 不基于 Docker 的组件</p>

      <h1 class="k-h1">容器启动，<br /><em class="k-underline">快过眨眼</em>。</h1>

      <p class="k-hero-lede">
        Kiri 用一条守护进程运行 Docker 容器。<code>docker</code> CLI、Compose、buildx 与 Docker Engine API
        都照常工作——只是背后的调用链更短，占用更小。
      </p>

      <div class="k-stat">
        <p class="k-stat-k">实测 · Docker Engine API</p>
        <div class="k-stat-main">
          <span class="k-big">≈80<small>×</small></span>
          <span class="k-stat-side">快于 Docker Desktop</span>
        </div>
        <p class="k-stat-cap">
          一次完整的容器生命周期：<strong>2.55 ms</strong> 对 <strong>213 ms</strong>。同一台 Apple Silicon Mac，
          <code>docker run --rm alpine true</code>，30 次取中位数。
        </p>
      </div>

      <div class="k-cta">
        <a href={DOWNLOAD_URL} target="_blank" rel="noopener" class="k-btn">
          <Icon name="ph:download-simple" class="h-[18px] w-[18px]" aria-hidden="true" />
          下载 Kiri
        </a>
        <a href={href("/quick-start/")} class="k-btn k-btn-ghost">
          阅读文档
          <Icon name="ph:arrow-right" class="h-[18px] w-[18px]" aria-hidden="true" />
        </a>
      </div>

      <p class="k-proof">
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />免费开源</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />macOS · Windows · Linux</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />不接管你现有的 docker</span>
      </p>

      <div class="k-langs">
        <p class="k-lang-k">
          <Icon name="ph:translate" class="h-[17px] w-[17px]" aria-hidden="true" />
          窗口与设置向导支持 {languages.length} 种语言
        </p>
        <ul class="k-lang-list" role="list">
          {languages.map((l) => <li class:list={[l === "简体中文" && "k-me"]}>{l}</li>)}
        </ul>
      </div>
    </div>

    <div class="k-hero-side">
      <figure class="k-hx" data-k-window>
        <div class="k-hx-glow" aria-hidden="true"></div>
        <div class="k-win" role="img" aria-label="Kiri 窗口示意：容器列表、资源占用与分享链接">
          <div class="k-win-bar">
            <i></i><i></i><i></i>
            <b>Kiri</b>
            <em>macOS · 0.2</em>
          </div>
          <div class="k-win-body">
            <div class="k-rail">
              {
                rail.map((r) => (
                  <span class:list={["k-rail-i", r.on && "is-on"]}>
                    <Icon name={r.icon} class="h-[18px] w-[18px]" aria-hidden="true" />
                  </span>
                ))
              }
              <span class="k-rail-i is-share"><Icon name="ph:cloud-arrow-up" class="h-[18px] w-[18px]" aria-hidden="true" /></span>
            </div>
            <div class="k-win-main">
              <div class="k-win-head">
                <b>容器</b>
                <span class="k-vm"><i></i>Linux VM 运行中</span>
              </div>

              <div class="k-stats">
                <div class="k-stat-tile">
                  <span class="k-tile-k">CPU</span>
                  <b data-k-cpu>0.4%</b>
                  <span class="k-spark" data-k-spark="cpu" aria-hidden="true">
                    {Array.from({ length: 10 }, () => <i style="height:30%"></i>)}
                  </span>
                </div>
                <div class="k-stat-tile">
                  <span class="k-tile-k">内存</span>
                  <b data-k-mem>657 MB</b>
                  <span class="k-spark is-mem" data-k-spark="mem" aria-hidden="true">
                    {Array.from({ length: 10 }, () => <i style="height:45%"></i>)}
                  </span>
                </div>
                <div class="k-stat-tile">
                  <span class="k-tile-k">启动</span>
                  <b>2.55 ms</b>
                  <small>Engine API</small>
                </div>
              </div>

              <ul class="k-list" role="list">
                {
                  rows.map((r) => (
                    <li class="k-row">
                      <span class:list={["k-row-dot", r.tone === "idle" && "is-idle", r.tone === "share" && "is-share"]} />
                      <span class="k-row-name">{r.name}</span>
                      <span class="k-row-img">{r.img}</span>
                      <span
                        class:list={["k-row-state", r.tone === "share" && "is-live"]}
                        data-k-up={r.up || undefined}
                      >
                        {r.state}
                      </span>
                    </li>
                  ))
                }
              </ul>

              <div class="k-share-row">
                <Icon name="ph:globe" class="h-4 w-4" aria-hidden="true" />
                <code>https://web.runkiri.cloud</code>
                <span>已连接</span>
              </div>
            </div>
          </div>
          <div class="k-win-foot">
            <span>4 / 5 运行</span>
            <span>docker → kiri</span>
            <span data-k-foot-mem>657 MB / 4 GB</span>
          </div>
        </div>
        <figcaption class="k-float">
          <b>2.55 ms</b>
          <span>一次容器生命周期</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>