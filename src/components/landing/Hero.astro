---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { QUICKSTART_URL, OFFICIAL_DOCS_URL, DOJO_URL } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;

const rail = [
  { icon: "ph:chats-circle", on: true },
  { icon: "ph:arrows-clockwise" },
  { icon: "ph:wrench" },
  { icon: "ph:layout" },
  { icon: "ph:user-switch" },
];

const rows = [
  { name: "RUN_STARTED", img: "会话启动", state: "已接收", tone: "live", up: 1 },
  { name: "TEXT_MESSAGE_*", img: "流式输出", state: "进行中", tone: "share", up: 128 },
  { name: "TOOL_CALL_*", img: "工具调用", state: "已完成", tone: "live", up: 42 },
  { name: "STATE_SNAPSHOT", img: "状态同步", state: "已同步", tone: "idle", up: 0 },
];
---

<section class="k-hero" id="top" tabindex="-1">
  <div class="k-wrap k-hero-grid">
    <div class="k-hero-copy">
      <p class="k-eyebrow"><span class="k-dot"></span>开放协议 · 事件驱动 · 实时双向</p>

      <h1 class="k-h1">让智能体<br /><em class="k-underline">真正融入用户界面</em>。</h1>

      <p class="k-hero-lede">
        AG-UI（Agent–User Interaction Protocol）标准化 AI 智能体与前端应用之间的交互方式。
        通过统一的事件流，你可以轻松实现流式聊天、共享状态、工具调用、生成式 UI 与人机协同。
      </p>

      <div class="k-stat">
        <p class="k-stat-k">协议定位 · Agentic Protocol Stack</p>
        <div class="k-stat-main">
          <span class="k-big">~16<small>类</small></span>
          <span class="k-stat-side">标准事件类型</span>
        </div>
        <p class="k-stat-cap">
          <strong>MCP</strong> 提供工具，<strong>A2A</strong> 连接智能体，<strong>AG-UI</strong> 负责将智能体能力带入面向用户的应用体验。
        </p>
      </div>

      <div class="k-cta">
        <a href={href(QUICKSTART_URL)} class="k-btn">
          <Icon name="ph:rocket-launch" class="h-[18px] w-[18px]" aria-hidden="true" />
          快速开始
        </a>
        <a href={href("/intro/")} class="k-btn k-btn-ghost">
          阅读文档
          <Icon name="ph:arrow-right" class="h-[18px] w-[18px]" aria-hidden="true" />
        </a>
      </div>

      <p class="k-proof">
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />开放协议 · MIT 许可</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />传输无关（SSE / WebSocket）</span>
        <span><Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />框架与客户端可互操作</span>
      </p>

      <div class="k-langs">
        <p class="k-lang-k">
          <Icon name="ph:globe" class="h-[17px] w-[17px]" aria-hidden="true" />
          适用于多种语言、框架与客户端形态
        </p>
        <ul class="k-lang-list" role="list">
          <li class="k-me"><a href={DOJO_URL} target="_blank" rel="noopener">AG-UI Dojo</a></li>
          <li><a href={OFFICIAL_DOCS_URL} target="_blank" rel="noopener">官方文档</a></li>
          <li>Web / 终端 / 聊天平台</li>
          <li>LangGraph · CrewAI · ADK 等</li>
        </ul>
      </div>
    </div>

    <div class="k-hero-side">
      <figure class="k-hx" data-k-window>
        <div class="k-hx-glow" aria-hidden="true"></div>
        <div class="k-win" role="img" aria-label="AG-UI 事件流示意：消息、工具与状态同步">
          <div class="k-win-bar">
            <i></i><i></i><i></i>
            <b>AG-UI Session</b>
            <em>event stream</em>
          </div>
          <div class="k-win-body">
            <div class="k-rail">
              {
                rail.map((r) => (
                  <span class:list={["k-rail-i", r.on && "is-on"]}>
                    <Icon name={r.icon} class="h-[18px] w-[18px]" aria-hidden="true" />
                  </span>
                ))
              }
              <span class="k-rail-i is-share"><Icon name="ph:plugs-connected" class="h-[18px] w-[18px]" aria-hidden="true" /></span>
            </div>
            <div class="k-win-main">
              <div class="k-win-head">
                <b>事件流</b>
                <span class="k-vm"><i></i>Agent ↔ UI 已连接</span>
              </div>

              <div class="k-stats">
                <div class="k-stat-tile">
                  <span class="k-tile-k">传输</span>
                  <b>SSE</b>
                  <small>或 WebSocket</small>
                </div>
                <div class="k-stat-tile">
                  <span class="k-tile-k">模式</span>
                  <b>双向</b>
                  <small>输入 + 事件</small>
                </div>
                <div class="k-stat-tile">
                  <span class="k-tile-k">能力</span>
                  <b>可组合</b>
                  <small>按需扩展</small>
                </div>
              </div>

              <ul class="k-list" role="list">
                {
                  rows.map((r) => (
                    <li class="k-row">
                      <span class:list={["k-row-dot", r.tone === "idle" && "is-idle", r.tone === "share" && "is-share"]} />
                      <span class="k-row-name">{r.name}</span>
                      <span class="k-row-img">{r.img}</span>
                      <span class:list={["k-row-state", r.tone === "share" && "is-live"]} data-k-up={r.up || undefined}>
                        {r.state}
                      </span>
                    </li>
                  ))
                }
              </ul>

              <div class="k-share-row">
                <Icon name="ph:link" class="h-4 w-4" aria-hidden="true" />
                <code>POST /agent/run → stream events</code>
                <span>实时</span>
              </div>
            </div>
          </div>
          <div class="k-win-foot">
            <span>标准化交互层</span>
            <span>Agent → AG-UI → App</span>
            <span>可观测 · 可调试</span>
          </div>
        </div>
        <figcaption class="k-float">
          <b>事件驱动</b>
          <span>流式 · 状态 · 工具 · 中断</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
