---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { platforms, howStats } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const first = platforms[0];
const hops = ["AG-UI 输入", "智能体执行", "标准事件", "客户端状态", "UI 渲染"];
---

<section class="k-section k-defer" id="how" tabindex="-1">
  <div class="k-wrap k-how-grid">
    <div data-reveal>
      <p class="k-kicker" data-code="ARCH-06">架构原理</p>
      <h2 class="k-h2">事件流连接智能体与界面。</h2>
      <p class="k-lede">
        AG-UI 位于智能体后端与用户应用之间：后端发出标准化事件表达消息、状态、工具与控制信号，前端订阅事件并将其映射为实时、可交互的用户体验。
      </p>
      <div class="k-how-stats">
        {
          howStats.map((s) => (
            <div class="k-tile">
              <div class="k-tile-v">
                {s.value}
                <small>{s.unit}</small>
              </div>
              <div class="k-tile-l">{s.label}</div>
              <p class="k-tile-d">{s.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="k-more">
        <a href={href("/concepts/architecture/")}>阅读核心架构文档 <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <div data-reveal>
      <div class="k-tabs" role="tablist" aria-label="选择客户端形态">
        {
          platforms.map((p, i) => (
            <button
              type="button"
              id={`k-tab-${p.id}`}
              class:list={["k-tab", i === 0 && "is-on"]}
              role="tab"
              tabindex={i === 0 ? 0 : -1}
              aria-selected={i === 0 ? "true" : "false"}
              data-k-platform={p.id}
            >
              <Icon name={p.icon} class="h-4 w-4" aria-hidden="true" />
              {p.name}
            </button>
          ))
        }
      </div>

      <div class="k-diagram" role="tabpanel" aria-labelledby={`k-tab-${first.id}`} tabindex="0" data-k-diagram>
        <div class="k-node">
          <div class="k-node-h">
            <Icon name="ph:robot" class="h-[18px] w-[18px]" aria-hidden="true" />
            智能体后端 · Agent Runtime
          </div>
          <p class="k-node-p">执行推理与工具调用，发出 AG-UI 兼容事件并接收输入</p>
        </div>

        <div class="k-channel">
          <span class="k-packet" aria-hidden="true"></span>
          <b data-k-channel>{first.channel}</b>
        </div>

        <div class="k-node is-guest">
          <div class="k-node-h">
            <Icon name="ph:app-window" class="h-[18px] w-[18px]" aria-hidden="true" />
            <span data-k-guest>{first.guest}</span>
          </div>
          <p class="k-node-p" data-k-guest-note>{first.guestNote}</p>
          <div class="k-chain">
            {hops.map((h, i) => <span class:list={["k-hop", i === hops.length - 1 && "is-last"]}>{h}</span>)}
          </div>
        </div>
      </div>

      <p class="k-rl-note" style="color:var(--k-muted);margin-top:14px">
        AG-UI 与 MCP、A2A 协同：MCP 连接工具与数据，A2A 连接智能体之间的协作，AG-UI 连接智能体与最终用户。
      </p>
    </div>
  </div>
</section>
