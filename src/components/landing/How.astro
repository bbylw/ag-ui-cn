---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { platforms, howStats } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const first = platforms[0];
const hops = ["clone3", "命名空间", "cgroup", "overlayfs", "容器"];
---

<section class="k-section" id="how">
  <div class="k-wrap k-how-grid">
    <div data-reveal>
      <p class="k-kicker" data-code="ARCH-06">工作原理</p>
      <h2 class="k-h2">一个小 VM，一条守护进程，一条通道。</h2>
      <p class="k-lede">
        在 macOS 上，Kiri 通过 Apple 的 Virtualization.framework 启动一个精简 Linux VM，使用自定义内核，用 Rust
        写的 <code>kiri-init</code> 作为 PID 1。宿主与来宾之间只有一条通道；容器由代理直接
        <code>clone3</code> 创建，没有 dockerd、containerd、shim 或 runc。
      </p>
      <div class="k-how-stats">
        {
          howStats.map((s) => (
            <div class="k-tile">
              <div class="k-tile-v">
                {s.value}
                <small>{s.unit}</small>
              </div>
              <div class="k-tile-l">{s.label}</div>
              <p class="k-tile-d">{s.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="k-more">
        <a href={href("/guide/how-it-works/")}>完整架构说明 <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <div data-reveal>
      <div class="k-tabs" role="tablist" aria-label="选择平台">
        {
          platforms.map((p, i) => (
            <button
              type="button"
              class:list={["k-tab", i === 0 && "is-on"]}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-k-platform={p.id}
            >
              <Icon name={p.icon} class="h-4 w-4" aria-hidden="true" />
              {p.name}
            </button>
          ))
        }
      </div>

      <div class="k-diagram" data-k-diagram>
        <div class="k-node">
          <div class="k-node-h">
            <Icon name="ph:hard-drives" class="h-[18px] w-[18px]" aria-hidden="true" />
            宿主机 · kiri 守护进程
          </div>
          <p class="k-node-p">Docker Engine API · 镜像与网络 · 端口转发 · VM 生命周期</p>
        </div>

        <div class="k-channel">
          <span class="k-packet" aria-hidden="true"></span>
          <b data-k-channel>{first.channel}</b>
        </div>

        <div class="k-node is-guest">
          <div class="k-node-h">
            <Icon name="ph:cube" class="h-[18px] w-[18px]" aria-hidden="true" />
            <span data-k-guest>{first.guest} · kiri-init（PID 1）</span>
          </div>
          <p class="k-node-p" data-k-guest-note>{first.guestNote}</p>
          <div class="k-chain">
            {hops.map((h, i) => <span class:list={["k-hop", i === hops.length - 1 && "is-last"]}>{h}</span>)}
          </div>
        </div>
      </div>

      <p class="k-rl-note" style="color:var(--k-muted);margin-top:14px">
        没有每容器常驻进程：容器退出后，命名空间与 cgroup 一并清理，VM 内不留下 shim。
      </p>
    </div>
  </div>
</section>