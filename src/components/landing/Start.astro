---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { steps } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<section class="k-section k-alt k-defer" id="start" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="START-05">上手路径</p>
      <h2 class="k-h2">四步接入 AG-UI 交互层。</h2>
      <p class="k-lede">从创建应用到扩展高级能力，逐步构建标准化的智能体用户体验。</p>
    </header>

    <ol class="k-st-grid" role="list">
      {
        steps.map((s, i) => (
          <li class="k-st" data-reveal data-i={i}>
            <span class="k-st-n"><span>{s.n}</span></span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <div class="k-cmd">
              <code>{s.code}</code>
              <button type="button" class="k-copy" data-copy={s.code} aria-label={`复制：${s.code}`}>
                <Icon name="ph:copy" class="h-3.5 w-3.5" aria-hidden="true" />
              </button>
            </div>
            {s.cta && (
              <a href={href(s.cta.href)} class="k-st-cta">
                {s.cta.label}
                <Icon name="ph:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            )}
          </li>
        ))
      }
    </ol>

    <p class="k-more">
      <a href={href("/quickstart/")}>查看完整快速开始指南 <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
