---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { DOJO_URL, GITHUB_URL } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<section class="k-section k-alt k-defer" id="share" tabindex="-1">
  <div class="k-wrap k-sh-grid">
    <div data-reveal>
      <p class="k-kicker" data-code="ECO-03">生态互操作</p>
      <h2 class="k-h2">一个协议，连接多种框架与客户端。</h2>
      <p class="k-lede">
        AG-UI 让智能体后端与用户界面解耦：后端可以来自不同框架或自研实现，前端可以是 Web、终端或聊天平台客户端，只要遵循同一事件与交互语义即可协作。
      </p>
      <ul class="k-sh-points" role="list">
        <li><b>框架接入。</b> LangGraph、CrewAI、Microsoft Agent Framework、Google ADK、Mastra 等已提供集成或支持。</li>
        <li><b>多端客户端。</b> 同一智能体可服务于 Web 应用、终端工具与 Slack / Teams 等聊天平台。</li>
        <li><b>示例可验证。</b> 在 AG-UI Dojo 中查看不同框架与特性的实时演示与源码思路。</li>
        <li><b>开放扩展。</b> 在标准事件之上通过自定义事件与中间件适配业务需求。</li>
      </ul>
      <div class="k-cta">
        <a href={href("/integrations/")} class="k-btn k-btn-sm">
          查看生态集成
          <Icon name="ph:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href={DOJO_URL} target="_blank" rel="noopener" class="k-btn k-btn-sm k-btn-ghost">打开 Dojo</a>
      </div>
      <details class="k-sh-disc">
        <summary class="k-btn k-btn-sm k-btn-ghost k-sh-sum">
          <span class="k-sh-sum-shut">AG-UI 与 A2UI 有什么不同？</span>
          <span class="k-sh-sum-open">收起说明</span>
          <Icon name="ph:caret-down" class="k-sh-caret h-4 w-4" aria-hidden="true" />
        </summary>
        <div class="k-sh-warn">
          <b><Icon name="ph:info" class="h-4 w-4" aria-hidden="true" />名称相近，定位不同</b>
          A2UI 是一种生成式 UI 规范，关注智能体如何交付 UI 组件；AG-UI 是 Agent ↔ User Interaction 协议，关注智能体前端与后端之间的实时交互连接。两者可以协同使用。
        </div>
      </details>
    </div>

    <figure class="k-sh-card" data-k-share data-reveal>
      <div class="k-sh-top">
        <span class="k-sh-live"><i></i><span data-k-share-state>开放生态</span></span>
        <code class="k-sh-url" data-k-share-url>{GITHUB_URL}</code>
        <button type="button" class="k-sh-btn" data-copy={GITHUB_URL} data-k-share-copy>复制</button>
      </div>
      <ul class="k-sh-list" role="list">
        <li style="--k-m: var(--k-rose)"><span class="k-sh-dot"></span><b>框架</b><code>LangGraph / CrewAI / ADK</code><em>后端</em></li>
        <li style="--k-m: var(--k-ember)"><span class="k-sh-dot"></span><b>协议</b><code>AG-UI Events</code><em>交互层</em></li>
        <li style="--k-m: var(--k-orchid)"><span class="k-sh-dot"></span><b>客户端</b><code>Web / CLI / Chat</code><em>前端</em></li>
      </ul>
      <div class="k-sh-foot">
        <span>同一协议语义 · 多种实现与运行环境</span>
        <a href={href("/intro/")} class="k-sh-toggle" style="text-decoration:none;display:inline-flex;align-items:center;">了解协议</a>
      </div>
    </figure>
  </div>
</section>
