---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { features } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const accent = { rose: "var(--k-rose)", teal: "var(--k-teal)", orchid: "var(--k-orchid)" } as const;
---

<section class="k-section k-alt k-defer" id="features" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="CORE-06">核心能力与事件族</p>
      <h2 class="k-h2">围绕交互语义构建的 6 项核心能力。</h2>
      <p class="k-lede">
        每项交互能力都对应一组标准化事件，使后端无需关心前端组件形态，前端也不必为每个框架重复编写解析胶水。
      </p>
    </header>

    <ul class="k-ft-grid" role="list">
      {
        features.map((f, i) => (
          <li class="k-ft-cell" data-reveal data-i={i % 3}>
            <article class="k-ft" style={f.tone ? `--k-ft-accent: ${accent[f.tone]}` : undefined}>
              <header class="k-ft-top">
                <span class="k-ft-ico">
                  <Icon name={f.icon} class="h-[22px] w-[22px]" aria-hidden="true" />
                </span>
                <code class="k-ft-ev">{f.eventTag}</code>
              </header>
              <div class="k-ft-body">
                <h3>
                  <a href={href(f.href)} class="k-ft-a">{f.title}</a>
                </h3>
                <p>{f.desc}</p>
              </div>
              <ol class="k-ft-trace" aria-label={`${f.title}的典型事件序列`}>
                {f.trace.map((t) => <li><code>{t}</code></li>)}
              </ol>
              <span class="k-ft-more" aria-hidden="true">
                查看规范与概念
                <Icon name="ph:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" />
              </span>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="k-more">
      <a href={href("/reference/events/")}>查阅全部 31 种标准事件类型与 8 大事件族参考 <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
