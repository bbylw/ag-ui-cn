---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { features } from "../../lib/landing";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const accent = { rose: "var(--k-rose)", teal: "var(--k-teal)", orchid: "var(--k-orchid)" } as const;
---

<section class="k-section k-alt k-defer" id="features" tabindex="-1">
  <div class="k-wrap">
    <header class="k-head" data-reveal>
      <p class="k-kicker" data-code="CORE-09">核心能力</p>
      <h2 class="k-h2">构建智能体应用所需的交互构建块。</h2>
      <p class="k-lede">
        从流式聊天到共享状态、从工具调用到人机协同，AG-UI 将复杂的智能体交互抽象为可组合、可扩展的标准能力。
      </p>
    </header>

    <ul class="k-ft-grid" role="list">
      {
        features.map((f, i) => (
          <li
            class="k-ft"
            style={f.tone ? `--k-ft-accent: ${accent[f.tone]}` : undefined}
            data-reveal
            data-i={i % 3}
          >
            <span class="k-ft-ico">
              <Icon name={f.icon} class="h-[22px] w-[22px]" aria-hidden="true" />
            </span>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            <a href={href(f.href)} class="k-ft-link">
              查看说明
              <Icon name="ph:arrow-right" class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
