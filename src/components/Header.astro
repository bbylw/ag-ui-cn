---
import Logo from "./Logo.astro";
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { ShortcutsToggle } from "./ui/shortcuts";
import { config } from "virtual:nimbus/config";
import { getCollectionUrl, getSidebarSections, stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  collection?: string;
  entryId?: string;
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const sidebarSections =
  sectionsProp ?? (await getSidebarSections(currentSlug, { collection }));
const apiHrefs = (
  await Promise.all((config.api ?? []).map(async (entry) => ({ entry, href: await getCollectionUrl(entry.collection) })))
).filter(({ href }) => href !== "/");
const mountOf = (href: string) => href.replace(/\/$/, "");
const activeApi = apiHrefs
  .filter(({ href }) => currentSlug === mountOf(href) || currentSlug.startsWith(`${mountOf(href)}/`))
  .sort((a, b) => b.href.length - a.href.length)[0];
const sections =
  sidebarSections.length >= 2 || sectionsProp || apiHrefs.length === 0
    ? sidebarSections
    : [
        { label: "文档", href: "/intro/", isActive: activeApi === undefined && collection !== undefined },
        ...apiHrefs.map((api) => ({
          label: apiHrefs.length === 1 ? "API 参考" : (api.entry.label ?? api.entry.collection),
          href: api.href,
          isActive: api === activeApi,
        })),
      ];
const showSections = sections.length >= 2;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string => withBase(href, import.meta.env.BASE_URL);
const docsHref = withBase("/intro/", import.meta.env.BASE_URL);
const quickstartHref = withBase("/quickstart/", import.meta.env.BASE_URL);
const isQuickstart = currentSlug === "/quickstart" || currentSlug.startsWith("/quickstart/");
const isDocs = currentSlug !== "/" && currentSlug !== "/404" && !isQuickstart;
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between gap-3 h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <slot name="brand">
        <a href={homeHref} class="flex shrink-0 items-center text-foreground transition-opacity hover:opacity-80">
          <Logo class="h-6 w-auto" />
          <span class="sr-only">{config.title}</span>
        </a>
      </slot>

      <nav aria-label="主导航" class="hidden md:flex items-center gap-1 ms-4 ps-4 border-s border-border h-6 min-w-0">
        <a href={docsHref} class:list={["px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors whitespace-nowrap", isDocs ? "text-foreground bg-accent" : "text-muted-foreground hover:text-foreground hover:bg-accent/60"]}>文档</a>
        <a href={quickstartHref} class:list={["px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors whitespace-nowrap", isQuickstart ? "text-foreground bg-accent" : "text-muted-foreground hover:text-foreground hover:bg-accent/60"]}>快速开始</a>
        <a href="https://docs.ag-ui.com/" target="_blank" rel="noopener" class="px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors whitespace-nowrap text-muted-foreground hover:text-foreground hover:bg-accent/60">官方文档</a>
      </nav>

      {showSections && currentSlug !== "/" && (
        <nav aria-label="文档分区" class="hidden lg:flex items-center gap-1 ms-2 ps-3 border-s border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
                section.isActive
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      {config.search !== false && <SearchTrigger />}
      {config.search === false && <ShortcutsToggle compact />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="打开导航"
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
  <nav aria-label="移动导航" data-nb-header-tabs class="md:hidden flex items-center gap-1 h-10 px-4 overflow-x-auto border-t border-border [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <a href={homeHref} class:list={["px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline whitespace-nowrap", currentSlug === "/" ? "text-foreground bg-accent" : "text-muted-foreground"]}>首页</a>
    <a href={docsHref} class:list={["px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline whitespace-nowrap", isDocs ? "text-foreground bg-accent" : "text-muted-foreground"]}>文档</a>
    <a href={quickstartHref} class:list={["px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline whitespace-nowrap", isQuickstart ? "text-foreground bg-accent" : "text-muted-foreground"]}>快速开始</a>
  </nav>
</header>
